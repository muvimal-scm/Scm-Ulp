# =============================================================================
# Beta UAT environment template. Copy to .env.beta on the server, fill in real
# values, then `chmod 600 .env.beta` (it contains secrets).
#
# DO NOT commit .env.beta. The .gitignore in this folder excludes it.
# =============================================================================

# --- Public domain (CP19 sets this up in DNS) -------------------------------
# Apex zone you control. Caddy serves app./api./kc./minio.<domain> off this.
ULP_DOMAIN=ulp-beta.example.com
ACME_EMAIL=ops@example.com

# --- MySQL ------------------------------------------------------------------
MYSQL_DATABASE=ulp_dev
MYSQL_ROOT_PASSWORD=__GENERATE_STRONG_PASSWORD__

# --- Redis ------------------------------------------------------------------
REDIS_PASSWORD=__GENERATE_STRONG_PASSWORD__

# --- RabbitMQ ---------------------------------------------------------------
RABBITMQ_USER=ulp
RABBITMQ_PASSWORD=__GENERATE_STRONG_PASSWORD__

# --- MinIO (S3 compatible blob store) ---------------------------------------
MINIO_ROOT_USER=ulp_admin
MINIO_ROOT_PASSWORD=__GENERATE_STRONG_PASSWORD_MIN_8_CHARS__

# --- Keycloak ---------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=__GENERATE_STRONG_PASSWORD__
KEYCLOAK_DB_PASSWORD=__GENERATE_STRONG_PASSWORD__

# --- SMTP for outgoing notifications + Keycloak password reset (CP20) -------
# Provider examples: AWS SES, SendGrid, Postmark, Resend.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=__SMTP_API_KEY__
SMTP_FROM=ulp-beta@example.com

# --- Beta admin bootstrap (CP20) --------------------------------------------
# A real reachable mailbox — Keycloak emails the password-reset + email-verify
# links here on first login. The temp password is intentionally throwaway:
# Keycloak forces UPDATE_PASSWORD + CONFIGURE_TOTP on first login.
BETA_ADMIN_EMAIL=admin@example.com
BETA_ADMIN_TEMP_PASSWORD=__GENERATE_TEMP_PASSWORD__

# --- Keycloak service-account secret (ulp-worker client) --------------------
# Used by background workers (Hangfire jobs, MassTransit consumers) when they
# need to call the API as a system user. Beta value is fine to rotate freely.
WORKER_CLIENT_SECRET=__GENERATE_STRONG_PASSWORD__

# --- Observability (CP21) ---------------------------------------------------
# Grafana — fronted by Caddy at https://grafana.<ULP_DOMAIN>. CP19 DNS step
# needs an extra record for `grafana.<domain>` before the obs stack comes up.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=__GENERATE_STRONG_PASSWORD__

# Sentry — leave empty to disable. Get a DSN from https://sentry.io for a free
# project. The API only ships errors upstream when this is set.
SENTRY_DSN=
