      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "DevPass!2345", "temporary": false }
      ],
      "attributes": {
        "tenant_id": ["1001"],
        "country_code": ["IN"],
        "region": ["in-central"],
        "permissions": ["invoice.read", "shipment.read"]
      },
      "realmRoles": ["ulp-user"]
    },
    {
      "username": "us-admin@ulp.local",
      "email": "us-admin@ulp.local",
      "firstName": "US",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "DevPass!2345", "temporary": false }
      ],
      "attributes": {
        "tenant_id": ["2001"],
        "country_code": ["US"],
        "region": ["us-east"],
        "permissions": ["invoice.write", "invoice.read", "shipment.write", "shipment.read", "tenant.admin"]
      },
      "realmRoles": ["ulp-admin", "ulp-user"]
    },
    {
      "username": "us-user@ulp.local",
      "email": "us-user@ulp.local",
      "firstName": "US",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "DevPass!2345", "temporary": false }
      ],
      "attributes": {
        "tenant_id": ["2001"],
        "country_code": ["US"],
        "region": ["us-east"],
        "permissions": ["invoice.read", "shipment.read"]
      },
      "realmRoles": ["ulp-user"]
    },
    {
      "username": "platform-admin@ulp.local",
      "email": "platform-admin@ulp.local",
      "firstName": "Platform",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "DevPass!2345", "temporary": false }
      ],
