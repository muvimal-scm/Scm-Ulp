# =====================================================================
# ULP local-dev environment variables
# Copy this file to `.env` and edit if needed. `.env` is gitignored.
# =====================================================================

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=dev_password
MYSQL_DATABASE=ulp_dev
MYSQL_USER=ulp
MYSQL_PASSWORD=dev_password
MYSQL_PORT=3306

# ---- Redis ----
REDIS_PORT=6379

# ---- RabbitMQ ----
RABBITMQ_USER=ulp
RABBITMQ_PASSWORD=dev_password
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ---- MinIO ----
MINIO_ROOT_USER=ulp
MINIO_ROOT_PASSWORD=dev_password_min8
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- MailHog ----
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# ---- Keycloak ----
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_PASSWORD=dev_password
KEYCLOAK_PORT=8080

# ---- Qdrant ----
QDRANT_REST_PORT=6333
QDRANT_GRPC_PORT=6334
